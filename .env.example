# Copy to .env (gitignored) and fill in. Never commit real values.

# HTTP port
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Postgres (Neon "dev" branch). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/mybuds?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/mybuds?sslmode=verify-full"

# Tests (npm run test:e2e) read a separate file, .env.test (also gitignored),
# with the same two keys pointing to the Neon "test" branch. Never the dev branch.
