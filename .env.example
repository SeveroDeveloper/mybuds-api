# Copy to .env (gitignored) and fill in. Never commit real values.

# HTTP port
PORT=3000

# Postgres (Neon "dev" branch). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/mybuds?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/mybuds?sslmode=require"
